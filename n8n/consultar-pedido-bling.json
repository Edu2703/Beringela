    {
      "parameters": {
        "jsCode": "const pedido = $('Conferir CPF').first().json.pedido;\nconst situacao = ($json.data && $json.data.nome) || 'não identificada';\nreturn [{ json: { resultado: { ...pedido, status: situacao } } }];"
      },
