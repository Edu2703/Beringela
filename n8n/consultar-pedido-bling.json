            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e2d3b863-c989-45b6-aa8b-3426dc3ded3c",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
