      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "url": "https://api.bling.com.br/Api/v3/pedidos/vendas",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "numerosLojas[]",
              "value": "={{ $('Entrada').first().json.numeroPedido.replace(/\\D/g, '') }}"
            }
          ]
        }
      },
      "id": "7c3f8229-4ac7-479d-bb41-4e20b4df0183",
      "name": "Buscar pelo número do site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Só aceita pedidos das lojas (IDs multiloja) desta marca\nconst ids = String($('Entrada').first().json.idsLoja).split(',').map(s => s.trim());\nconst lista = [\n  ...($('Buscar pelo número Bling').first().json.data || []),\n  ...($('Buscar pelo número do site').first().json.data || []),\n];\nconst pedido = lista.find(p => ids.includes(String(p.loja && p.loja.id)));\nreturn [{ json: { encontrado: !!pedido, idPedido: pedido ? pedido.id : null } }];"
      },
      "id": "77552689-f5ab-4431-8277-06b7d4896229",
      "name": "Escolher pedido da loja",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "318a1f6e-a492-4afd-aa4a-294043224fb2",
              "leftValue": "={{ $json.encontrado }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "09bd8c0a-80ea-4397-ad1e-5770af8edf38",
      "name": "Achou?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.bling.com.br/Api/v3/pedidos/vendas/{{ $json.idPedido }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      },
      "id": "788e1be8-220b-4780-91dc-387b802128b3",
      "name": "Detalhes do pedido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Só libera os dados se o CPF/CNPJ informado for o do cliente do pedido\nconst p = $json.data || {};\nconst ids = String($('Entrada').first().json.idsLoja).split(',').map(s => s.trim());\nconst so = v => String(v || '').replace(/\\D/g, '');\nconst cpfInformado = so($('Entrada').first().json.cpf);\nconst cpfPedido = so(p.contato && p.contato.numeroDocumento);\nif (!cpfInformado || cpfInformado !== cpfPedido || !ids.includes(String(p.loja && p.loja.id))) {\n  return [{ json: { ok: false } }];\n}\nconst t = p.transporte || {};\nreturn [{ json: {\n  ok: true,\n  situacaoId: p.situacao && p.situacao.id,\n  pedido: {\n    numero: p.numero,\n    numeroSite: p.numeroLoja,\n    data: p.data,\n    dataSaida: p.dataSaida,\n    cliente: p.contato && p.contato.nome,\n    itens: (p.itens || []).map(i => ({ produto: i.descricao, quantidade: i.quantidade, valor: i.valor })),\n    totalProdutos: p.totalProdutos,\n    frete: t.frete,\n    total: p.total,\n    transportadora: t.contato && t.contato.nome,\n    rastreios: (t.volumes || []).map(v => ({ servico: v.servico, codigo: v.codigoRastreamento })).filter(v => v.codigo),\n  },\n} }];"
      },
      "id": "ef117637-61d0-4c53-9b84-c2c50457e042",
      "name": "Conferir CPF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
