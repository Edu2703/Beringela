{
  "name": "TESTE - Vinculo com ID na loja = 0",
  "nodes": [
    {
      "parameters": {},
      "id": "b1000000-0001-4000-8000-000000000001",
      "name": "Iniciar teste",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.bling.com.br/Api/v3/produtos/lojas",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "idProduto",
              "value": "COLE_AQUI_O_ID_DO_SOLARIS"
            },
            {
              "name": "limite",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0002-4000-8000-000000000002",
      "name": "Busca vinculos do produto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Teste: troca o \"ID na loja\" (codigo) de todos os vinculos deste produto para \"0\"\nconst vinculos = $input.first().json.data || [];\n\nif (vinculos.length === 0) {\n  throw new Error('Nenhum vinculo encontrado para este produto. Confira o idProduto no no \"Busca vinculos do produto\".');\n}\n\n// seguranca: so continua se todos os vinculos forem do mesmo produto\nconst produtos = new Set(vinculos.map(v => Number(v.produto && v.produto.id)));\nif (produtos.size > 1) {\n  throw new Error('A busca trouxe vinculos de mais de um produto. Parei para nao alterar o que nao devia.');\n}\n\nreturn vinculos.map(v => {\n  const corpo = { ...v };\n  delete corpo.id;\n  corpo.codigo = '0';\n  return { json: { idVinculo: v.id, loja: v.loja && v.loja.id, corpo: corpo } };\n});"
      },
      "id": "b1000000-0003-4000-8000-000000000003",
      "name": "Troca ID na loja para 0",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b1000000-0004-4000-8000-000000000004",
      "name": "Um por vez",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ 'https://api.bling.com.br/Api/v3/produtos/lojas/' + $json.idVinculo }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.corpo) }}",
        "options": {}
      },
      "id": "b1000000-0005-4000-8000-000000000005",
      "name": "Atualiza vinculo no Bling",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
