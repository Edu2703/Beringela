{
  "name": "TESTE - Vinculo com ID na loja = 0",
  "nodes": [
    {
      "parameters": {},
      "id": "b1000000-0001-4000-8000-000000000001",
      "name": "Iniciar teste",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// ===== EDITE AQUI: ID do produto no Bling (so os numeros) =====\nconst ID_PRODUTO = 0;\n// ===============================================================\n\nif (!ID_PRODUTO) throw new Error('Coloque o ID do produto na linha 2 do no \"Configuracao\".');\nreturn [{ json: { idProduto: ID_PRODUTO } }];"
      },
      "id": "b1000000-0007-4000-8000-000000000007",
      "name": "Configuracao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.bling.com.br/Api/v3/produtos/lojas",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "idProduto",
              "value": "={{ $json.idProduto }}"
            },
            {
              "name": "limite",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0002-4000-8000-000000000002",
      "name": "Busca vinculos do produto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Teste: troca o \"ID na loja\" (codigo) dos vinculos DESTE produto para \"0\"\nconst idProduto = Number($('Configuracao').first().json.idProduto);\nconst todos = $input.first().json.data || [];\n\n// seguranca: usa so os vinculos do produto configurado, ignora qualquer outro\nconst vinculos = todos.filter(v => Number(v.produto && v.produto.id) === idProduto);\n\nif (vinculos.length === 0) {\n  throw new Error(`Nenhum vinculo encontrado para o produto ${idProduto}. A busca trouxe ${todos.length} vinculos de outros produtos.`);\n}\n\nreturn vinculos.map(v => {\n  // o ID do vinculo pode vir com nomes diferentes na resposta do Bling\n  const idVinculo = v.id || v.idProdutoLoja || (v.produtoLoja && v.produtoLoja.id);\n  if (!idVinculo) {\n    throw new Error('Nao achei o ID do vinculo. Campos recebidos: ' + JSON.stringify(v));\n  }\n  const corpo = { ...v };\n  corpo.id = idVinculo; // o Bling tambem quer o ID do vinculo dentro do corpo\n  corpo.codigo = '0';\n  return { json: { idVinculo: idVinculo, loja: v.loja && v.loja.id, corpo: corpo } };\n});"
      },
      "id": "b1000000-0003-4000-8000-000000000003",
      "name": "Troca ID na loja para 0",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        0
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b1000000-0004-4000-8000-000000000004",
      "name": "Um por vez",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        920,
        0
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ 'https://api.bling.com.br/Api/v3/produtos/lojas/' + $json.idVinculo }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.corpo) }}",
        "options": {}
      },
      "id": "b1000000-0005-4000-8000-000000000005",
