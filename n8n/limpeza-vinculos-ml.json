{
  "name": "LIMPEZA - Vinculos do Mercado Livre",
  "nodes": [
    {
      "parameters": {},
      "id": "d1000000-0001-4000-8000-000000000001",
      "name": "Iniciar limpeza",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// ===== EDITE AQUI: SKUs dos produtos que vao perder o vinculo do Mercado Livre =====\nconst SKUS = [\n  'BW-022033',\n  'BW-022034',\n  'YSPR100-100',\n  'EDGE2',\n  'SF881',\n  'SF882',\n  'SF883',\n  'SF884',\n  'SF889',\n  'SF891',\n  'SF892',\n  'FA9510',\n  'FA9511',\n  'GB479-V',\n  'GB479-P',\n  'GB479-B',\n  'GB478-V',\n  'GB478-P',\n  'GB478-B',\n  'GB466-V',\n  'GB466-P',\n  'GB466-B',\n  'GB462-P',\n  'GB462-B',\n  'HA165C',\n  'HA165D',\n  'HA165R',\n  'HL101P',\n];\n// ===================================================================================\n\nreturn SKUS.map(sku => ({ json: { sku: String(sku).trim() } }));"
      },
      "id": "d1000000-0002-4000-8000-000000000002",
      "name": "Lista de SKUs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.bling.com.br/Api/v3/produtos",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "codigos[]",
              "value": "={{ $json.sku }}"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          }
        }
      },
      "id": "d1000000-0003-4000-8000-000000000003",
      "name": "Busca produto pelo SKU",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Pega o ID do Bling de cada SKU (so aceita SKU exatamente igual)\nconst skus = new Set($('Lista de SKUs').all().map(i => i.json.sku));\nconst achados = {};\nfor (const resp of $input.all()) {\n  for (const p of (resp.json.data || [])) {\n    if (skus.has(String(p.codigo).trim())) achados[p.codigo] = p.id;\n  }\n}\nconst faltando = [...skus].filter(s => !achados[s]);\nif (Object.keys(achados).length === 0) {\n  throw new Error('Nenhum SKU encontrado no Bling.');\n}\nreturn Object.entries(achados).map(([sku, id]) => ({\n  json: { sku, idProduto: id, skusNaoEncontrados: faltando }\n}));"
      },
      "id": "d1000000-0004-4000-8000-000000000004",
      "name": "Pega IDs dos produtos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.bling.com.br/Api/v3/produtos/lojas",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "idProduto",
              "value": "={{ $json.idProduto }}"
            },
            {
              "name": "limite",
              "value": "100"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          }
        }
      },
      "id": "d1000000-0005-4000-8000-000000000005",
      "name": "Busca vinculos do produto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Separa so os vinculos das lojas do Mercado Livre desses produtos\nconst LOJAS_ML = new Set([205134455, 206096286, 204279939]);\nconst produtos = {};\nfor (const i of $('Pega IDs dos produtos').all()) produtos[Number(i.json.idProduto)] = i.json.sku;\n\nconst vistos = new Set();\nconst saida = [];\nfor (const resp of $input.all()) {\n  for (const v of (resp.json.data || [])) {\n    const idLoja = Number(v.loja && v.loja.id);\n    const idProduto = Number(v.produto && v.produto.id);\n    if (!LOJAS_ML.has(idLoja) || !(idProduto in produtos)) continue; // seguranca\n    if (!v.id || vistos.has(v.id)) continue;\n    vistos.add(v.id);\n    saida.push({ json: { idVinculo: v.id, sku: produtos[idProduto], idProduto, idLoja } });\n  }\n}\nif (saida.length === 0) {\n  throw new Error('Nenhum vinculo do Mercado Livre encontrado nesses produtos. Nada para apagar.');\n}\nreturn saida;"
      },
      "id": "d1000000-0006-4000-8000-000000000006",
      "name": "Seleciona vinculos do ML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
